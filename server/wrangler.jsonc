{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devora-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
