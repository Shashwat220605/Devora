{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devora-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4e36ec94faeb49eda9b5609ef3934858"
    }
  ],
  "observability": {
    "enabled": true
  }
}
